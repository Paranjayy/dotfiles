{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/Users/paranjay/.config/fastfetch/avatar.png",
        "type": "iterm",
        "width": 30,
        "height": 15,
        "padding": {
            "top": 2,
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "separator": " -> ",
        "color": {
            "keys": "magenta",
            "title": "blue"
        }
    },
    "modules": [
        "title",
        {
            "type": "separator",
            "string": "-"
        },
        {
            "type": "command",
            "key": "Software",
            "keyColor": "magenta",
            "text": "echo \"\u001b[3m(system basics)\u001b[0m\""
        },
        {
            "type": "os",
            "key": "OS",
            "keyColor": "blue"
        },
        {
            "type": "host",
            "key": "Host",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": "Kernel",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "key": "Shell",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "key": "Packages",
            "keyColor": "blue"
        },
        {
            "type": "command",
            "key": "Theme",
            "keyColor": "blue",
            "text": "defaults read -g AppleInterfaceStyle >/dev/null 2>&1 && echo \"🌙 Dark\" || echo \"☀️ Light\""
        },
        {
            "type": "command",
            "key": "Now Playing",
            "keyColor": "blue",
            "text": "/Users/paranjay/.config/fastfetch/now_playing.sh"
        },
        "separator",
        {
            "type": "command",
            "key": "Hardware",
            "keyColor": "magenta",
            "text": "echo \"\u001b[3m(the internals)\u001b[0m\""
        },
        {
            "type": "cpu",
            "key": "CPU",
            "keyColor": "blue"
        },
        {
            "type": "gpu",
            "key": "GPU",
            "keyColor": "blue"
        },
        {
            "type": "memory",
            "key": "Memory",
            "keyColor": "blue"
        },
        {
            "type": "swap",
            "key": "Swap",
            "keyColor": "blue"
        },
        {
            "type": "disk",
            "key": "Disk",
            "keyColor": "blue"
        },
        "separator",
        {
            "type": "command",
            "key": "OS Age / Status",
            "keyColor": "magenta",
            "text": "echo \"\u001b[3m(live data)\u001b[0m\""
        },
        {
            "type": "command",
            "key": "OS Age",
            "keyColor": "blue",
            "text": "birth_time=$(stat -f %B /); current_time=$(date +%s); echo \"$(date -r $birth_time '+%b %d %Y') ($(( (current_time - birth_time) / 86400 )) days)\""
        },
        {
            "type": "uptime",
            "key": "Uptime",
            "keyColor": "blue"
        },
        {
            "type": "command",
            "key": "Booted",
            "keyColor": "blue",
            "text": "date -r \"$(sysctl -n kern.boottime | awk '{print $4}' | tr -d ',')\" '+%a %b %d, %I:%M %p'"
        },
        {
            "type": "command",
            "key": "Prev Boot",
            "keyColor": "blue",
            "text": "out=$(last reboot 2>/dev/null | sed -n 's/^reboot *time *//p' | sed -n '2p'); [ -n \"$out\" ] && echo \"$out\" || echo Unknown"
        },
        {
            "type": "command",
            "key": "First Setup",
            "keyColor": "blue",
            "text": "stat -f '%SB' /var/db/.AppleSetupDone 2>/dev/null || echo Unknown"
        },
        {
            "type": "command",
            "key": "Updated",
            "keyColor": "blue",
            "text": "plutil -p /Library/Receipts/InstallHistory.plist 2>/dev/null | awk '/\"date\" =>/ {d=$3} /\"displayName\" => \"macOS/ {v=$4; gsub(/\"/, \"\", v); last=\"macOS \"v\" (\"d\")\"} END {print last}'"
        },
        {
            "type": "command",
            "key": "Load Averages",
            "keyColor": "blue",
            "text": "uptime | awk -F'load averages:' '{ print $2 }' | sed 's/^ //'"
        },
        {
            "type": "command",
            "key": "Processes",
            "keyColor": "blue",
            "text": "ps -ax | wc -l | tr -d ' '"
        },
        {
            "type": "command",
            "key": "Project",
            "keyColor": "blue",
            "text": "basename $(pwd)"
        },
        {
            "type": "locale",
            "key": "Locale",
            "keyColor": "blue"
        }
    ]
}
