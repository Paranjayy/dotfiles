# whkd config — Match omniwm keybindings
; AHK sends Ctrl+Alt combos for Right-Alt-only triggers
; Right Alt + WASD = Focus (right+opt+wasd)
; Right Alt + Shift + WASD = Move (right+cmd+wasd)
; Right Alt + 1-5 = Switch workspace (right+cmd+1-9)
; Right Alt + Shift + 1-5 = Move to workspace

; ── Focus Windows (Right Opt + WASD) ──────────────────────────
ctrl + alt + w  : komorebic focus up
ctrl + alt + a  : komorebic focus left
ctrl + alt + s  : komorebic focus down
ctrl + alt + d  : komorebic focus right

; ── Move Windows (Right Cmd + WASD) ───────────────────────────
ctrl + shift + alt + w  : komorebic move up
ctrl + shift + alt + a  : komorebic move left
ctrl + shift + alt + s  : komorebic move down
ctrl + shift + alt + d  : komorebic move right

; ── Workspaces (Right Cmd + 1-5) ──────────────────────────────
ctrl + alt + 1  : komorebic focus-workspace 0
ctrl + alt + 2  : komorebic focus-workspace 1
ctrl + alt + 3  : komorebic focus-workspace 2
ctrl + alt + 4  : komorebic focus-workspace 3
ctrl + alt + 5  : komorebic focus-workspace 4

; ── Move to Workspace (Right Cmd + Shift + 1-5) ───────────────
ctrl + shift + alt + 1  : komorebic move-to-workspace 0
ctrl + shift + alt + 2  : komorebic move-to-workspace 1
ctrl + shift + alt + 3  : komorebic move-to-workspace 2
ctrl + shift + alt + 4  : komorebic move-to-workspace 3
ctrl + shift + alt + 5  : komorebic move-to-workspace 4

; ── Window Actions ─────────────────────────────────────────────
ctrl + alt + g  : komorebic toggle-float
ctrl + alt + f  : komorebic toggle-fullscreen
ctrl + alt + q  : komorebic toggle-quake-console
ctrl + alt + `  : komorebic toggle-quake-console
ctrl + shift + alt + x  : komorebic close

; ── Resize ─────────────────────────────────────────────────────
ctrl + alt + up    : komorebic resize-axis height decrease
ctrl + alt + down  : komorebic resize-axis height increase
ctrl + alt + left  : komorebic resize-axis width decrease
ctrl + alt + right : komorebic resize-axis width increase

; ── Layout ─────────────────────────────────────────────────────
ctrl + shift + alt + l  : komorebic cycle-layout
ctrl + shift + alt + b  : komorebic balance-ratio
ctrl + shift + alt + r  : komorebic reload-config
