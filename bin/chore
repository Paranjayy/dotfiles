#!/usr/bin/env zsh
# chore: Quick commit and push for chores/small changes.

BLUE='\033[1;34m'
GREEN='\033[1;32m'
RESET='\033[0m'

if [[ -z "$1" ]]; then
    echo -e "${BLUE}Usage: chore \"message\"${RESET}"
    exit 1
fi

MSG="chore: $1"

echo -e "${BLUE}🧹 Cleaning up with chore: ${MSG}...${RESET}"
git add .
git commit -m "$MSG"
git push
echo -e "${GREEN}✅ Chore complete.${RESET}"
