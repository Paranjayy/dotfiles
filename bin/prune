#!/usr/bin/env zsh
# prune: Delete local branches that have been merged into origin/main.

CYAN='\033[1;36m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RESET='\033[0m'

echo -e "${CYAN}🔄 Fetching and pruning...${RESET}"
git fetch --all --prune

MERGED=$(git branch --merged origin/main | grep -v "^\*\|main$")
if [[ -z "$MERGED" ]]; then
    echo -e "${YELLOW}No merged branches to prune.${RESET}"
else
    echo "$MERGED" | xargs git branch -d
    echo -e "${GREEN}✅ Pruning complete.${RESET}"
fi
