#!/usr/bin/env zsh
# yeet: Stage, commit, and push everything with one command.

# Colors
MAGENTA='\033[1;35m'
CYAN='\033[1;36m'
GREEN='\033[1;32m'
RESET='\033[0m'

if [[ -z "$1" ]]; then
    echo -e "${MAGENTA}Usage: yeet \"commit message\"${RESET}"
    exit 1
fi

MESSAGE="$1"

echo -e "${CYAN}🚀 Yeeting changes...${RESET}"

# Check status
echo -e "${MAGENTA}Status:${RESET}"
git status --short

# Show diff summary
echo -e "\n${MAGENTA}Diff Summary:${RESET}"
git diff --stat

# Confirm
echo -en "\n${CYAN}Commit all changes with message '${MESSAGE}' and push? [Y/n] ${RESET}"
read -r CONFIRM
if [[ "$CONFIRM" != "y" && "$CONFIRM" != "Y" && "$CONFIRM" != "" ]]; then
    echo -e "${MAGENTA}Yeet aborted.${RESET}"
    exit 0
fi

# Execute
git add .
git commit -m "$MESSAGE"
git push

echo -e "\n${GREEN}✅ Successfully yeeted to origin!${RESET}"
