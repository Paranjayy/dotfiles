#!/usr/bin/env zsh
# squash: Auto-squash fixup commits against origin/main.

MAGENTA='\033[1;35m'
RESET='\033[0m'

BRANCH=$(git branch --show-current)
TARGET="origin/main"

echo -e "${MAGENTA}🔨 Squashing fixups into ${TARGET}...${RESET}"
git rebase -i --autosquash "$TARGET"
echo -e "${MAGENTA}✅ Squash complete.${RESET}"
