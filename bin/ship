#!/usr/bin/env bash
# ship — Weekly dev dashboard (cross-platform)
# Works in bash/zsh/Git Bash/WSL

DEV_DIR="${DEV_DIR:-$HOME/Developer}"
MEMORY_DIR="${MEMORY_DIR:-$HOME/.omni_memory}"

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
MAGENTA='\033[1;35m'
CYAN='\033[1;36m'
BOLD='\033[1m'
RESET='\033[0m'

commits=0
added=0
deleted=0
projects=()

since=$(date -d "7 days ago" +%Y-%m-%d 2>/dev/null || date -v-7d +%Y-%m-%d 2>/dev/null)

for dir in "$DEV_DIR"/*/; do
    [ -d "$dir/.git" ] || continue
    name=$(basename "$dir")
    c=$(git -C "$dir" rev-list --count --since="$since" HEAD 2>/dev/null || echo 0)
    [ "$c" -eq 0 ] && continue
    stats=$(git -C "$dir" log --since="$since" --pretty=tformat: --numstat 2>/dev/null)
    a=$(echo "$stats" | awk '{s+=$1} END {print s+0}')
    d=$(echo "$stats" | awk '{s+=$2} END {print s+0}')
    commits=$((commits + c))
    added=$((added + a))
    deleted=$((deleted + d))
    projects+=("$c|$name|$a")
done

sorted=$(printf '%s\n' "${projects[@]}" | sort -t'|' -k1 -rn | head -5)

echo ""
echo -e "${BOLD}${MAGENTA}  🚀 Your Week: $(date '+%b %d')${RESET}"
echo ""
echo -e "  ${BOLD}${commits}${RESET} commits across ${BOLD}${#projects[@]}${RESET} projects"
echo -e "  ${GREEN}+$(echo "scale=1; $added/1000" | bc)k${RESET} added · ${RED}-$(echo "scale=1; $deleted/1000" | bc)k${RESET} deleted · ${CYAN}$(echo "scale=1; ($added-$deleted)/1000" | bc)k${RESET} net"
echo ""

if [ -n "$sorted" ]; then
    echo -e "  ${BOLD}TOP PROJECTS${RESET}"
    echo "$sorted" | while IFS='|' read -r c n a; do
        printf "  %-20s %s commits    +%sk\n" "$n" "$c" "$(echo "scale=1; $a/1000" | bc)"
    done
fi
echo ""
