#!/usr/bin/env bash
# countdown — Countdown to a date
# Usage: countdown 2026-12-31

if [ -z "$1" ]; then
    echo "Usage: countdown <YYYY-MM-DD>"
    exit 1
fi

target=$(date -d "$1" +%s 2>/dev/null || date -j -f "%Y-%m-%d" "$1" +%s 2>/dev/null)
now=$(date +%s)
diff=$((target - now))
days=$((diff / 86400))

if [ "$days" -lt 0 ]; then
    echo "That date has passed!"
else
    echo "📅 $days days until $1"
fi
