{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "svgl-search-pro",
  "version": "1.1.0",
  "title": "SVGL Search Pro",
  "description": "Premium brand logo discovery & high-fidelity asset search",
  "icon": "icon.svg",
  "author": "antigravity",
  "license": "MIT",
  "commands": [
    {
      "name": "search",
      "title": "Search SVGs",
      "description": "Find any brand SVG logo",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.71.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.8",
    "@types/node": "20.8.10",
    "@types/react": "18.2.27",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "eslint src --fix",
    "lint": "eslint src"
  }
}