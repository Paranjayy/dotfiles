                    "type": "number"
                  },
                  "mem": {
                    "type": "number"
                  }
                }
              },
              "updateAvailable": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string"
                  },
                  "permissions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "x-realtime-bindings": {
              "read": "getApp",
              "create": "app.create",
              "update": "app.update",
              "delete": "app.delete"
            }
          }
        }
