                  },
                  "email": {
                    "type": "string"
                  }
                }
              },
              "permissions": {
                "x-homey-readonly": true,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "images": {
                "x-homey-readonly": true,
                "type": "object",
                "properties": {
                  "small": {
                    "type": "string"
                  },
                  "large": {
                    "type": "string"
                  }
                }
              },
              "session": {
                "x-homey-readonly": true,
                "type": "string"
