// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "agent": {
    "show_turn_stats": true,
    "use_modifier_to_send": true,
    "play_sound_when_agent_done": "always",
    "single_file_review": true,
    "dock": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "right"
  },
  "agent_servers": {
    "cline": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "qwen-code": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    },
    "gemini": {
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    }
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Dark",
    "dark": "macOS Classic Dark"
  },
}
